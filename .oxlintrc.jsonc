{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "promise",
    "vitest",
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "restriction": "off",
    "nursery": "off",
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "vitest": true,
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "dist-ssr/**",
    ".agents/**",
    ".tanstack/**",
    ".vinxi/**",
    ".wrangler/**",
    ".output/**",
    "src/routeTree.gen.ts",
  ],
  "settings": {
    "react": {
      "version": "19.2.0",
      "linkComponents": [{ "name": "Link", "linkAttribute": "to" }],
    },
    "jsx-a11y": {
      "components": {
        "Link": "a",
      },
    },
  },
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/html-has-lang": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/__tests__/**/*.{ts,tsx}"],
      "rules": {
        "no-console": "off",
      },
    },
    {
      "files": ["vite.config.ts", "scripts/**/*.{ts,tsx,js,mjs,cjs}"],
      "env": {
        "browser": false,
        "node": true,
      },
      "rules": {
        "no-console": "off",
      },
    },
  ],
  "options": {
    "reportUnusedDisableDirectives": "warn",
  },
}
